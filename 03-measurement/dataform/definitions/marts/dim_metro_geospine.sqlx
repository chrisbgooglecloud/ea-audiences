config {
  type: "table",
  schema: "ea_measurement",
  tags: ["marts", "geospine"],
  description: "Complete 210 DMA Google Ads metro spine dimension table with coordinates, population, and gaming density index.",
  columns: {
    dma_code: "Google Ads Metro Criteria ID / DMA Code (e.g., 501, 803)",
    dma_name: "Metro Market Name",
    state: "Primary State abbreviation",
    latitude: "Centroid latitude",
    longitude: "Centroid longitude",
    population: "Metropolitan area population",
    gaming_density_index: "Index of active gaming hardware & broadband penetration (1.0 = national average)",
    centroid_geom: "Centroid point geography representation",
    timezone: "Primary local timezone",
    updated_at: "Timestamp of last record update"
  }
}

SELECT
  dma_code,
  dma_name,
  state,
  latitude,
  longitude,
  population,
  gaming_density_index,
  ST_GEOGPOINT(longitude, latitude) AS centroid_geom,
  timezone,
  CURRENT_TIMESTAMP() AS updated_at
FROM UNNEST([
  STRUCT(500 AS dma_code, 'Portland-Auburn' AS dma_name, 'ME' AS state, 43.6615 AS latitude, -70.2553 AS longitude, 985000 AS population, 0.95 AS gaming_density_index, 'America/New_York' AS timezone),
  STRUCT(501 AS dma_code, 'New York' AS dma_name, 'NY' AS state, 40.7128 AS latitude, -74.006 AS longitude, 20140000 AS population, 1.25 AS gaming_density_index, 'America/New_York' AS timezone),
  STRUCT(502 AS dma_code, 'Binghamton' AS dma_name, 'NY' AS state, 42.0987 AS latitude, -75.918 AS longitude, 240000 AS population, 0.88 AS gaming_density_index, 'America/New_York' AS timezone),
